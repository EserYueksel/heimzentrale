LOG = os.environ.get("HZ_AGENT_LOG", "/var/log/heimzentrale-agent.log")
BIN_DIR = os.environ.get("HZ_AGENT_BIN", "/usr/local/bin")
os.environ["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

